#!/usr/bin/env bash
# sentinelctl — install, upgrade, roll back and inspect SentinelEdgeAI on a device.
#
#   sudo ./sentinelctl install  sentineledgeai-pi-1.1.0.tar.gz   # first install
#   sudo sentinelctl upgrade    sentineledgeai-pi-1.2.0.tar.gz   # later versions
#   sudo sentinelctl rollback                                     # back to the previous version
#   sentinelctl status | versions
#   sudo sentinelctl tls import cert.pem key.pem   # use your organisation's certificate
#   sudo sentinelctl tls renew                     # new self-signed certificate
#   sentinelctl tls show                           # certificate details and fingerprint
#   sudo sentinelctl backup  /root/sentinel.seab   # encrypted backup of config, keys, policy, data
#   sudo sentinelctl restore /root/sentinel.seab   # onto this device (install first on a fresh one)
#   sudo sentinelctl update [--check] [--to X.Y.Z] # over-the-air: verified download, health-checked, auto-rollback
#   sudo sentinelctl fleet-update                  # install the version a fleet rollout asks for (run by a timer)
#   sudo sentinelctl preset home|office|ot|enterprise
#
# On-device layout (code is replaceable, state is never touched by upgrades):
#   /opt/sentineledgeai/releases/<version>/   code + its own Python venv
#   /opt/sentineledgeai/current  -> releases/<version>   (active version)
#   /opt/sentineledgeai/previous -> releases/<version>   (rollback target)
#   /etc/sentinel/      sentinel.env, config.yaml, model_signing.key, tls/
#   /var/lib/sentinel/  database, firewall state, alerts, profiles
#   /var/log/sentinel/  logs
set -euo pipefail

PREFIX="${SENTINEL_PREFIX:-/opt/sentineledgeai}"
ETC_DIR="${SENTINEL_ETC_DIR:-/etc/sentinel}"
STATE_DIR="${SENTINEL_STATE_DIR:-/var/lib/sentinel}"
LOG_DIR="${SENTINEL_LOG_DIR:-/var/log/sentinel}"
SERVICE_USER="${SENTINEL_USER:-sentinel}"
KEEP_RELEASES="${SENTINEL_KEEP_RELEASES:-3}"
HEALTH_TIMEOUT="${SENTINEL_HEALTH_TIMEOUT:-90}"
SYSTEMD_DIR="${SENTINEL_SYSTEMD_DIR:-/etc/systemd/system}"
SBIN_DIR="${SENTINEL_SBIN_DIR:-/usr/local/sbin}"
SERVICES=(sentineledgeai-engine.service sentineledgeai-api.service)
ROLE_PATHS=(sentineledgeai-brain.path sentineledgeai-sensor.path sentineledgeai-fleet.path sentineledgeai-fleet-agent.path)
ROLE_SERVICES=(sentineledgeai-brain.service sentineledgeai-sensor.service sentineledgeai-fleet.service)
MIN_PYTHON="3.11"
# interpreter for the release venv; the Jetson installer points this at a uv-managed CPython 3.11
PYTHON_BIN="${SENTINEL_PYTHON:-$(cat "$ETC_DIR/python" 2>/dev/null || echo python3)}"

# Runtime files the application writes relative to its working directory.
# Each becomes a symlink from the release directory into STATE_DIR.
STATE_FILES=(alerts.json device_profiles.json risk_timeline.json live_stats.json
             live_events.jsonl health.json flows.csv flows_history.jsonl
             firewall_rules.json firewall_policy.json firewall_restrictions.json)

log()  { printf '[sentinelctl] %s\n' "$*"; }
die()  { printf '[sentinelctl] ERROR: %s\n' "$*" >&2; exit 1; }

require_root() { [ "$(id -u)" -eq 0 ] || die "run as root (sudo)"; }

usage() {
  sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

check_python() {
  command -v "$PYTHON_BIN" >/dev/null || die "$PYTHON_BIN not found (apt install python3 python3-venv, or set SENTINEL_PYTHON)"
  "$PYTHON_BIN" -c "import sys; sys.exit(0 if sys.version_info >= tuple(map(int, '$MIN_PYTHON'.split('.'))) else 1)" \
    || die "Python >= $MIN_PYTHON required, found $("$PYTHON_BIN" -V 2>&1) (set SENTINEL_PYTHON to a newer interpreter)"
  "$PYTHON_BIN" -c "import venv, ensurepip" 2>/dev/null || die "venv/ensurepip missing for $PYTHON_BIN (apt install python3-venv)"
}

verify_checksum() {
  local tarball="$1" sum="$1.sha256"
  if [ -f "$sum" ]; then
    (cd "$(dirname "$tarball")" && sha256sum -c "$(basename "$sum")" >/dev/null) \
      || die "checksum mismatch for $tarball"
    log "checksum OK"
  elif [ "${SENTINEL_ALLOW_UNVERIFIED:-0}" = "1" ]; then
    log "WARNING: no $sum found; continuing because SENTINEL_ALLOW_UNVERIFIED=1"
  else
    die "missing $sum (download it with the package, or set SENTINEL_ALLOW_UNVERIFIED=1)"
  fi
}

ensure_user_and_dirs() {
  if ! id "$SERVICE_USER" >/dev/null 2>&1; then
    useradd --system --home-dir "$STATE_DIR" --shell /usr/sbin/nologin "$SERVICE_USER"
    log "created system user $SERVICE_USER"
  fi
  install -d -m 755 "$PREFIX" "$PREFIX/releases"
  install -d -m 750 -o root -g "$SERVICE_USER" "$ETC_DIR"
  install -d -m 750 -o "$SERVICE_USER" -g "$SERVICE_USER" "$STATE_DIR" "$STATE_DIR/data" "$LOG_DIR"
}

ensure_config() {
  local release="$1" env_file="$ETC_DIR/sentinel.env"
  if [ ! -f "$env_file" ]; then
    local api_key
    api_key="$("$PYTHON_BIN" -c 'import secrets; print(secrets.token_hex(32))')"
    local old_umask
    old_umask="$(umask)"
    umask 027
    cat > "$env_file" <<EOF
# SentinelEdgeAI runtime settings. Created by sentinelctl; upgrades never overwrite it.
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=9000
# Required for every API call from another machine (header X-API-Key).
DASHBOARD_API_KEY=$api_key
# 1 = record firewall actions only. Set 0 to enforce, then restart the services.
FIREWALL_DRY_RUN=1
SENTINEL_FIREWALL_BACKEND=auto
SENTINEL_MODEL_SIGNING_KEY_FILE=$ETC_DIR/model_signing.key
SENTINEL_DB_PATH=data/sentinel.db
# Firewall rollback guard (timer): set to 1 once enforcement is enabled.
ENABLE_ROLLBACK_GUARD=0
# Engine Prometheus metrics (the API serves its own on /metrics)
app__metrics_port=9101
EOF
    umask "$old_umask"
    chown root:"$SERVICE_USER" "$env_file"
    chmod 640 "$env_file"
    log "created $env_file with a new random DASHBOARD_API_KEY"
  fi
  if ! grep -q '^app__metrics_port=' "$env_file"; then
    # engine metrics moved off 8001, which other software often uses
    echo "app__metrics_port=9101" >> "$env_file"
  fi
  install -d -m 750 -o "$SERVICE_USER" -g "$SERVICE_USER" "$STATE_DIR/reports"
  if [ ! -f "$ETC_DIR/config.yaml" ]; then
    install -m 640 -o root -g "$SERVICE_USER" "$release/config.yaml" "$ETC_DIR/config.yaml"
    log "created $ETC_DIR/config.yaml from the release defaults"
  fi
  local key="$ETC_DIR/model_signing.key"
  if [ -f "$key" ]; then
    chown root:"$SERVICE_USER" "$key"
    chmod 640 "$key"
  elif ! grep -q '^SENTINEL_ALLOW_UNSIGNED_MODELS=1' "$env_file"; then
    die "model signing key missing: install it with
       sudo bash $release/deploy/pi/provision_key.sh /path/to/model_signing.key
     then run this command again."
  fi
}

TLS_DIR="$ETC_DIR/tls"
TLS_DAYS="${SENTINEL_TLS_DAYS:-825}"

env_value() {
  sed -n "s/^$1=//p" "$ETC_DIR/sentinel.env" | tail -1
}

tls_enabled() {
  [ -n "$(env_value SENTINEL_TLS_CERT)" ]
}

install_tls_pair() {
  local cert="$1" key="$2"
  install -d -m 750 -o root -g "$SERVICE_USER" "$TLS_DIR"
  install -m 644 -o root -g "$SERVICE_USER" "$cert" "$TLS_DIR/cert.pem.new"
  install -m 640 -o root -g "$SERVICE_USER" "$key" "$TLS_DIR/key.pem.new"
  mv -f "$TLS_DIR/cert.pem.new" "$TLS_DIR/cert.pem"
  mv -f "$TLS_DIR/key.pem.new" "$TLS_DIR/key.pem"
}

new_self_signed_cert() {
  # EC P-256 certificate naming the device's hostname and current addresses
  local host san ip tmp
  command -v openssl >/dev/null || die "openssl not found (apt install openssl)"
  host="$(hostname -s 2>/dev/null || hostname)"
  san="DNS:$host,DNS:$host.local,DNS:localhost,IP:127.0.0.1,IP:::1"
  for ip in $(hostname -I 2>/dev/null); do
    case "$ip" in
      172.1[6-9].*|172.2[0-9].*|172.3[01].*) continue ;;  # docker bridges
      *) san="$san,IP:$ip" ;;
    esac
  done
  tmp="$(mktemp -d)"
  if ! openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
      -keyout "$tmp/key.pem" -out "$tmp/cert.pem" -days "$TLS_DAYS" \
      -subj "/CN=$host/O=SentinelEdgeAI" -addext "subjectAltName=$san" \
      -addext "basicConstraints=critical,CA:FALSE" \
      -addext "keyUsage=critical,digitalSignature" -addext "extendedKeyUsage=serverAuth" \
      >/dev/null 2>&1; then
    rm -rf "$tmp"
    die "could not create a TLS certificate"
  fi
  install_tls_pair "$tmp/cert.pem" "$tmp/key.pem"
  rm -rf "$tmp"
  log "created a self-signed TLS certificate for $san"
}

ensure_tls() {
  # HTTPS by default, also for devices upgraded from a release without it.
  # Empty SENTINEL_TLS_CERT= and SENTINEL_TLS_KEY= lines keep plain HTTP.
  local env_file="$ETC_DIR/sentinel.env"
  if ! grep -q '^SENTINEL_TLS_CERT=' "$env_file"; then
    {
      echo "# HTTPS for the console and API. Use 'sentinelctl tls import' for your own"
      echo "# certificate; set both to empty values for plain HTTP."
      echo "SENTINEL_TLS_CERT=$TLS_DIR/cert.pem"
      echo "SENTINEL_TLS_KEY=$TLS_DIR/key.pem"
    } >> "$env_file"
    log "enabled HTTPS in $env_file"
  fi
  if tls_enabled && [ ! -f "$TLS_DIR/cert.pem" ]; then
    new_self_signed_cert
  fi
}

link_state() {
  local release="$1" name
  rm -rf "$release/data" "$release/logs" "$release/config.yaml"
  ln -s "$STATE_DIR/data" "$release/data"
  ln -s "$LOG_DIR" "$release/logs"
  ln -s "$ETC_DIR/config.yaml" "$release/config.yaml"
  for name in "${STATE_FILES[@]}"; do
    rm -f "$release/$name"
    ln -s "$STATE_DIR/$name" "$release/$name"
  done
}

ensure_admin_user() {
  # First install (or first upgrade to a release with accounts): create the
  # console user 'admin' with a one-time password. No-op once any user exists.
  local release="$1" db="$STATE_DIR/data/auth.db" pw="$ETC_DIR/initial-admin-password" out
  out="$(cd "$release" && SENTINEL_AUTH_DB="$db" "$release/.venv/bin/python" -m core.auth \
    bootstrap-admin --password-file "$pw")" || die "could not create the console admin user"
  chown "$SERVICE_USER:$SERVICE_USER" "$db"
  chmod 600 "$db"
  if [ -f "$pw" ]; then
    chown root:root "$pw"
    chmod 600 "$pw"
  fi
  case "$out" in
    created*) log "console user 'admin' created; its one-time password is in $pw (root only)."
              log "sign in, choose a new password, then delete that file" ;;
  esac
}

build_venv() {
  local release="$1"
  "$PYTHON_BIN" -m venv "$release/.venv"
  if [ -d "$release/wheels" ]; then
    "$release/.venv/bin/pip" install --quiet --no-index --find-links "$release/wheels" -r "$release/requirements.txt"
  elif [ "${SENTINEL_ALLOW_ONLINE_INSTALL:-0}" = "1" ]; then
    log "no bundled wheels; installing dependencies from the internet"
    "$release/.venv/bin/pip" install --quiet -r "$release/requirements.txt"
  else
    die "package has no wheels/ directory (set SENTINEL_ALLOW_ONLINE_INSTALL=1 to download dependencies)"
  fi
}

install_units() {
  local release="$1" unit
  for unit in "$release"/packaging/systemd/*.service "$release"/packaging/systemd/*.timer \
              "$release"/packaging/systemd/*.path; do
    [ -f "$unit" ] || continue
    install -m 644 "$unit" "$SYSTEMD_DIR/$(basename "$unit")"
  done
  install -m 755 "$release/packaging/sentinelctl" "$SBIN_DIR/sentinelctl"
  systemctl daemon-reload
  # the new release's own script knows its units; an older sentinelctl running this upgrade does not
  if [ "${SENTINEL_ENABLE_UNITS_SELF:-0}" != "1" ] && [ -x "$release/packaging/sentinelctl" ]; then
    SENTINEL_ENABLE_UNITS_SELF=1 "$release/packaging/sentinelctl" enable-units && return 0
  fi
  enable_units
}

enable_units() {
  local unit
  systemctl enable "${SERVICES[@]}" sentineledgeai-rollback-guard.timer >/dev/null
  systemctl enable --now sentineledgeai-watchdog.timer sentineledgeai-intel.timer sentineledgeai-report.timer \
    sentineledgeai-fleet-update.timer >/dev/null 2>&1 || true
  # two-node services start only once the device has that role (see the .path units)
  for unit in "${ROLE_PATHS[@]}"; do
    if [ -f "$SYSTEMD_DIR/$unit" ]; then
      systemctl enable --now "$unit" >/dev/null 2>&1 || true
    fi
  done
}

switch_to() {
  # Atomically point `current` at $1 and remember the old target as `previous`.
  local target="$1" old
  old="$(readlink "$PREFIX/current" 2>/dev/null || true)"
  if [ -n "$old" ] && [ "$old" != "$target" ]; then
    ln -sfn "$old" "$PREFIX/previous.tmp" && mv -Tf "$PREFIX/previous.tmp" "$PREFIX/previous"
  fi
  ln -sfn "$target" "$PREFIX/current.tmp" && mv -Tf "$PREFIX/current.tmp" "$PREFIX/current"
}

api_key() {
  sed -n 's/^DASHBOARD_API_KEY=//p' "$ETC_DIR/sentinel.env" | tail -1
}

healthy() {
  local deadline=$((SECONDS + HEALTH_TIMEOUT)) port code svc scheme=http
  port="$(env_value SENTINEL_PORT)"
  if tls_enabled; then scheme=https; fi
  while [ "$SECONDS" -lt "$deadline" ]; do
    sleep 3
    for svc in "${SERVICES[@]}"; do
      systemctl is-active --quiet "$svc" || continue 2
    done
    # loopback check; -k because an imported certificate may not name 127.0.0.1
    code="$(curl -s -k -o /dev/null -w '%{http_code}' -H "X-API-Key: $(api_key)" \
             "$scheme://127.0.0.1:${port:-9000}/openapi.json" || true)"
    [ "$code" = "200" ] || continue
    # a crash-looping service still looks "active" between restarts, so it
    # must also stay up without any automatic restart for a settle period
    sleep "${SENTINEL_HEALTH_SETTLE:-15}"
    stable
    return $?
  done
  return 1
}

stable() {
  local svc
  for svc in "${SERVICES[@]}"; do
    if ! systemctl is-active --quiet "$svc" || \
       [ "$(systemctl show -p NRestarts --value "$svc")" != "0" ]; then
      log "$svc is restarting; see journalctl -u $svc"
      return 1
    fi
  done
}

restart_and_check() {
  systemctl restart "${SERVICES[@]}"
  local svc
  for svc in "${ROLE_SERVICES[@]}"; do
    # pick up the new code if this device runs a two-node role
    systemctl try-restart "$svc" >/dev/null 2>&1 || true
  done
  healthy
}

prune_releases() {
  local current previous dir kept=0
  current="$(readlink "$PREFIX/current" 2>/dev/null || true)"
  previous="$(readlink "$PREFIX/previous" 2>/dev/null || true)"
  # newest first; always keep current and previous
  for dir in $(ls -1dt "$PREFIX"/releases/*/ 2>/dev/null); do
    dir="${dir%/}"
    if [ "$dir" = "$current" ] || [ "$dir" = "$previous" ]; then continue; fi
    kept=$((kept + 1))
    if [ "$kept" -gt $((KEEP_RELEASES - 2)) ]; then
      rm -rf "$dir"
      log "removed old release $(basename "$dir")"
    fi
  done
}

cmd_install() {
  require_root
  local tarball="${1:-}"
  [ -n "$tarball" ] && [ -f "$tarball" ] || usage 1
  tarball="$(cd "$(dirname "$tarball")" && pwd)/$(basename "$tarball")"
  check_python
  verify_checksum "$tarball"

  local tmp version release
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  tar -xzf "$tarball" -C "$tmp"
  local src
  src="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -1)"
  [ -f "$src/VERSION" ] || die "package has no VERSION file"
  version="$(tr -d '[:space:]' < "$src/VERSION")"
  release="$PREFIX/releases/$version"

  if [ "$(readlink "$PREFIX/current" 2>/dev/null || true)" = "$release" ]; then
    die "version $version is already active"
  fi

  log "installing SentinelEdgeAI $version"
  ensure_user_and_dirs
  rm -rf "$release"
  mv "$src" "$release"
  ensure_config "$release"
  ensure_tls
  build_venv "$release"
  # code is root-owned and read-only to the service; state links are added after
  chown -R root:root "$release"
  chmod -R u+rwX,go+rX,go-w "$release"
  link_state "$release"
  ensure_admin_user "$release"
  install_units "$release"

  switch_to "$release"
  if restart_and_check; then
    log "SentinelEdgeAI $version is running"
    console_url
    prune_releases
    return 0
  fi

  log "health check failed for $version"
  local previous
  previous="$(readlink "$PREFIX/previous" 2>/dev/null || true)"
  if [ -n "$previous" ] && [ -d "$previous" ]; then
    log "rolling back to $(basename "$previous")"
    ln -sfn "$previous" "$PREFIX/current.tmp" && mv -Tf "$PREFIX/current.tmp" "$PREFIX/current"
    rm -f "$PREFIX/previous"
    install_units "$previous"
    if restart_and_check; then
      log "rolled back to $(basename "$previous"); $version left in $release for inspection"
    else
      log "previous version is also unhealthy; check: journalctl -u sentineledgeai-engine -u sentineledgeai-api"
    fi
  else
    log "no previous version to roll back to; check: journalctl -u sentineledgeai-engine -u sentineledgeai-api"
  fi
  exit 1
}

cmd_rollback() {
  require_root
  local previous current
  previous="$(readlink "$PREFIX/previous" 2>/dev/null || true)"
  current="$(readlink "$PREFIX/current" 2>/dev/null || true)"
  [ -n "$previous" ] && [ -d "$previous" ] || die "no previous release to roll back to"
  log "rolling back $(basename "$current") -> $(basename "$previous")"
  switch_to "$previous"
  install_units "$previous"
  if restart_and_check; then
    log "now running $(basename "$previous")"
  else
    die "services unhealthy after rollback; check journalctl -u sentineledgeai-engine -u sentineledgeai-api"
  fi
}

tls_self_signed() {
  local cert="$TLS_DIR/cert.pem"
  [ -r "$cert" ] || return 1
  [ "$(openssl x509 -in "$cert" -noout -issuer -nameopt RFC2253 | sed 's/^issuer=//')" = \
    "$(openssl x509 -in "$cert" -noout -subject -nameopt RFC2253 | sed 's/^subject=//')" ]
}

console_url() {
  local scheme=http ip
  if tls_enabled; then scheme=https; fi
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  log "console: $scheme://${ip:-<device-address>}:$(env_value SENTINEL_PORT)"
  if tls_enabled && tls_self_signed; then
    log "the certificate is self-signed: the browser warns once; compare the fingerprint from 'sentinelctl tls show'"
  fi
}

cmd_tls() {
  local action="${1:-show}" cert key
  case "$action" in
    show)
      cert="$(env_value SENTINEL_TLS_CERT)"
      if [ -z "$cert" ]; then
        echo "HTTPS is off (SENTINEL_TLS_CERT is empty in $ETC_DIR/sentinel.env)"
        return 0
      fi
      [ -r "$cert" ] || die "cannot read $cert"
      openssl x509 -in "$cert" -noout -subject -issuer -enddate -ext subjectAltName
      openssl x509 -in "$cert" -noout -fingerprint -sha256
      ;;
    renew)
      require_root
      new_self_signed_cert
      ensure_tls
      systemctl restart sentineledgeai-api.service
      log "restarted the API with the new certificate"
      ;;
    import)
      require_root
      cert="${2:-}" key="${3:-}"
      [ -f "$cert" ] && [ -f "$key" ] || die "usage: sentinelctl tls import cert.pem key.pem"
      openssl x509 -in "$cert" -noout 2>/dev/null || die "$cert is not a PEM certificate"
      openssl pkey -in "$key" -noout -passin pass: 2>/dev/null \
        || die "$key is not an unencrypted PEM private key"
      [ "$(openssl x509 -in "$cert" -noout -pubkey | openssl sha256)" = \
        "$(openssl pkey -in "$key" -pubout | openssl sha256)" ] || die "the key does not match the certificate"
      openssl x509 -in "$cert" -noout -checkend 0 >/dev/null || die "the certificate has expired"
      install_tls_pair "$cert" "$key"
      ensure_tls
      systemctl restart sentineledgeai-api.service
      log "installed $cert and restarted the API"
      ;;
    *) die "usage: sentinelctl tls show | renew | import cert.pem key.pem" ;;
  esac
}

cmd_backup() {
  require_root
  local out="${1:-}"
  [ -n "$out" ] || die "usage: sentinelctl backup /path/to/file.seab"
  [ -x "$PREFIX/current/.venv/bin/python" ] || die "SentinelEdgeAI is not installed"
  (cd "$PREFIX/current" && .venv/bin/python -m ops.backup --etc "$ETC_DIR" --state "$STATE_DIR" create "$out")
}

cmd_restore() {
  require_root
  local file="${1:-}" svc
  [ -f "$file" ] || die "usage: sentinelctl restore /path/to/file.seab"
  [ -x "$PREFIX/current/.venv/bin/python" ] || die "install SentinelEdgeAI first, then restore"
  # check the passphrase and every checksum before touching anything
  if [ -z "${SENTINEL_BACKUP_PASSPHRASE:-}" ]; then
    read -r -s -p "Backup passphrase: " SENTINEL_BACKUP_PASSPHRASE; echo
    export SENTINEL_BACKUP_PASSPHRASE
  fi
  (cd "$PREFIX/current" && .venv/bin/python -m ops.backup --etc "$ETC_DIR" --state "$STATE_DIR" restore --dry-run "$file") \
    || die "backup not restored"
  log "stopping services"
  systemctl stop sentineledgeai-watchdog.timer "${SERVICES[@]}" "${ROLE_SERVICES[@]}" 2>/dev/null || true
  (cd "$PREFIX/current" && .venv/bin/python -m ops.backup --etc "$ETC_DIR" --state "$STATE_DIR" restore "$file") \
    || die "restore failed; services left stopped, see the message above"
  chown -R "$SERVICE_USER:$SERVICE_USER" "$STATE_DIR"
  chown -R root:"$SERVICE_USER" "$ETC_DIR"
  chmod 750 "$ETC_DIR"
  for svc in "$ETC_DIR"/model_signing.key "$ETC_DIR"/tls/key.pem "$ETC_DIR"/sentinel.env; do
    [ -f "$svc" ] && chmod 640 "$svc"
  done
  systemctl start sentineledgeai-watchdog.timer >/dev/null 2>&1 || true
  if restart_and_check; then
    log "restored $file; SentinelEdgeAI is running"
  else
    die "services unhealthy after restore; check journalctl -u sentineledgeai-engine -u sentineledgeai-api"
  fi
}

UPDATE_URL="${SENTINEL_UPDATE_URL:-https://api.github.com/repos/vishwa-10147/SentinelEdgeAI/releases/latest}"
COSIGN_IDENTITY="${SENTINEL_COSIGN_IDENTITY:-^https://github.com/vishwa-10147/SentinelEdgeAI/}"

current_version() {
  basename "$(readlink "$PREFIX/current" 2>/dev/null || echo none)"
}

latest_release() {
  # prints "<version> <tarball url>"; a file:// mirror holds latest.json {"version", "tarball"}
  # with a version argument, the GitHub release of that tag (a mirror only serves its latest)
  local json url="$UPDATE_URL"
  if [ -n "${1:-}" ] && [[ "$url" == */releases/latest ]]; then
    url="${url%/latest}/tags/v$1"
  fi
  if [[ "$url" == file://* ]]; then
    json="$(cat "${url#file://}/latest.json")" || return 1
  else
    json="$(curl -fsSL --max-time 30 "$url")" || return 1
  fi
  printf '%s' "$json" | "$PYTHON_BIN" -c '
import json, sys
d = json.load(sys.stdin)
if "tag_name" in d:
    v = d["tag_name"].lstrip("v")
    url = next(a["browser_download_url"] for a in d["assets"] if a["name"] == f"sentineledgeai-pi-{v}.tar.gz")
else:
    v, url = d["version"], d["tarball"]
print(v, url)'
}

fetch() {  # fetch <url> <dest>
  if [[ "$1" == file://* ]]; then cp "${1#file://}" "$2"; else curl -fsSL --max-time 600 -o "$2" "$1"; fi
}

cmd_update() {
  local check_only=0 want="" latest url current tmp file
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check_only=1 ;;
      --to) shift; want="${1:-}"; [[ "$want" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "--to needs a version like 2.4.0" ;;
      *) die "unknown update option: $1" ;;
    esac
    shift
  done
  read -r latest url < <(latest_release "$want") || die "could not read release ${want:-latest} from $UPDATE_URL"
  [ -n "$latest" ] && [ -n "$url" ] || die "no release found at $UPDATE_URL"
  [ -z "$want" ] || [ "$latest" = "$want" ] || die "release $want is not available (the source offers $latest)"
  current="$(current_version)"
  # compare X.Y.Z; a dev suffix (e.g. -dev.<commit>) cannot be ordered, so any different
  # build of the same or a newer base version counts as an update
  local base_latest="${latest%%-*}" base_current="${current%%-*}"
  if [ "$current" = "$latest" ] || { [ "$base_latest" != "$base_current" ] && \
       [ "$(printf '%s\n%s\n' "$base_latest" "$base_current" | sort -V | tail -1)" = "$base_current" ]; }; then
    log "up to date ($current; latest release $latest)"
    return 0
  fi
  log "update available: $current -> $latest"
  [ "$check_only" -eq 1 ] && return 0
  require_root
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  file="$tmp/sentineledgeai-pi-$latest.tar.gz"
  fetch "$url" "$file" || die "download failed"
  fetch "$url.sha256" "$file.sha256" || die "checksum file missing; refusing to install"
  if fetch "$url.cosign.bundle" "$file.cosign.bundle" 2>/dev/null && command -v cosign >/dev/null; then
    cosign verify-blob --bundle "$file.cosign.bundle" --certificate-oidc-issuer https://token.actions.githubusercontent.com \
      --certificate-identity-regexp "$COSIGN_IDENTITY" "$file" >/dev/null 2>&1 \
      || die "Sigstore signature verification FAILED for $latest; not installing"
    log "Sigstore signature verified"
  elif [ "${SENTINEL_REQUIRE_SIGNATURE:-0}" = "1" ]; then
    die "signature required (SENTINEL_REQUIRE_SIGNATURE=1) but cosign or the bundle is missing"
  else
    log "WARNING: signature not checked (install cosign to verify releases); checksum still enforced"
  fi
  # same path as a manual upgrade: checksum, health check, automatic rollback
  cmd_install "$file"
}

cmd_fleet_update() {
  # the fleet agent (unprivileged) writes the version its group's rollout wants; install it here
  local dir="$STATE_DIR/data/fleet_agent" want current ok=true msg
  [ -f "$dir/desired_version" ] || { log "no fleet rollout pending"; return 0; }
  want="$(tr -d '[:space:]' < "$dir/desired_version")"
  [[ "$want" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid desired version: $want"
  current="$(current_version)"
  if [ "$current" = "$want" ]; then
    log "already on $want"
    return 0
  fi
  if [ "$(printf '%s\n%s\n' "$want" "${current%%-*}" | sort -V | tail -1)" = "${current%%-*}" ] && [ "${current%%-*}" != "$want" ]; then
    log "refusing to downgrade from $current to $want"
    return 0
  fi
  if msg="$( (cmd_update --to "$want") 2>&1 )"; then ok=true; else ok=false; fi
  printf '%s\n' "$msg"
  "$PYTHON_BIN" -c 'import json, sys, time
print(json.dumps({"version": sys.argv[1], "ok": sys.argv[2] == "true", "at": int(time.time()), "message": sys.argv[3][-500:]}))' \
    "$want" "$ok" "$msg" > "$dir/update_result.json"
  chown "$SERVICE_USER:$SERVICE_USER" "$dir/update_result.json"
  [ "$ok" = true ]
}

cmd_preset() {
  require_root
  local name="${1:-}" file
  file="$PREFIX/current/presets/$name.yaml"
  [ -n "$name" ] && [ -f "$file" ] || die "usage: sentinelctl preset home|office|ot|enterprise"
  (cd "$PREFIX/current" && sudo -u "$SERVICE_USER" .venv/bin/python -m enforcement policy diff "$file") || die "invalid preset"
  (cd "$PREFIX/current" && sudo -u "$SERVICE_USER" .venv/bin/python -m enforcement policy apply "$file" --by "preset:$name")
  log "applied the $name preset (recorded in the audit log)"
}

cmd_status() {
  local current previous svc
  current="$(readlink "$PREFIX/current" 2>/dev/null || true)"
  previous="$(readlink "$PREFIX/previous" 2>/dev/null || true)"
  echo "current:  ${current:+$(basename "$current")}"
  echo "previous: ${previous:+$(basename "$previous")}"
  for svc in "${SERVICES[@]}" sentineledgeai-rollback-guard.timer "${ROLE_SERVICES[@]}"; do
    printf '%-40s %s\n' "$svc" "$(systemctl is-active "$svc" 2>/dev/null || true)"
  done
}

cmd_versions() {
  local current dir
  current="$(readlink "$PREFIX/current" 2>/dev/null || true)"
  for dir in "$PREFIX"/releases/*/; do
    [ -d "$dir" ] || continue
    dir="${dir%/}"
    if [ "$dir" = "$current" ]; then echo "* $(basename "$dir")"; else echo "  $(basename "$dir")"; fi
  done
}

case "${1:-}" in
  install|upgrade) shift; cmd_install "$@" ;;
  rollback)        cmd_rollback ;;
  status)          cmd_status ;;
  versions)        cmd_versions ;;
  tls)             shift; cmd_tls "$@" ;;
  backup)          shift; cmd_backup "$@" ;;
  update)          shift; cmd_update "$@" ;;
  fleet-update)    cmd_fleet_update ;;
  enable-units)    require_root; enable_units ;;
  preset)          shift; cmd_preset "$@" ;;
  restore)         shift; cmd_restore "$@" ;;
  -h|--help|help)  usage 0 ;;
  *)               usage 1 ;;
esac
