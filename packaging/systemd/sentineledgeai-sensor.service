[Unit]
Description=SentinelEdgeAI sensor link (sends flows to the brain, executes signed commands)
Documentation=https://github.com/vishwa-10147/SentinelEdgeAI
After=network-online.target sentineledgeai-engine.service
Wants=network-online.target
# started by sentineledgeai-sensor.path once the device is enrolled with a brain
ConditionPathExists=/var/lib/sentinel/data/sensor/sensor.json

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentineledgeai/current
EnvironmentFile=/etc/sentinel/sentinel.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/sentineledgeai/current/.venv/bin/python -m sensor run
Restart=on-failure
RestartSec=5
# exit 78: the device no longer has this role
RestartPreventExitStatus=78

# verified brain commands change firewall rules
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sentinel /var/log/sentinel

# resource limits: see sentineledgeai-engine.service
CPUWeight=80
TasksMax=128
OOMScoreAdjust=300
MemoryMax=15%

[Install]
WantedBy=multi-user.target
