[Unit]
Description=SentinelEdgeAI brain (sensor-facing mutual TLS service)
Documentation=https://github.com/vishwa-10147/SentinelEdgeAI
After=network-online.target
Wants=network-online.target
# started by sentineledgeai-brain.path once Setup chose the Brain role
ConditionPathExists=/var/lib/sentinel/data/brain/enabled

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentineledgeai/current
EnvironmentFile=/etc/sentinel/sentinel.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/sentineledgeai/current/.venv/bin/python -m brain.server
Restart=on-failure
RestartSec=5
# exit 78: the device no longer has this role
RestartPreventExitStatus=78

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sentinel /var/log/sentinel

[Install]
WantedBy=multi-user.target
