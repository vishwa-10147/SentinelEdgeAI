[Unit]
Description=SentinelEdgeAI detection engine (capture, flows, detection)
Documentation=https://github.com/vishwa-10147/SentinelEdgeAI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentineledgeai/current
EnvironmentFile=/etc/sentinel/sentinel.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/sentineledgeai/current/.venv/bin/python -u main.py
Restart=on-failure
RestartSec=5

# Packet capture needs CAP_NET_RAW; firewall enforcement needs CAP_NET_ADMIN.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sentinel /var/log/sentinel

# flood safety: under load the engine yields CPU to the console and SSH, and is the first
# process the kernel kills if memory runs out (systemd restarts it; the watchdog fails open).
# MemoryHigh/Max apply where the memory cgroup is enabled (Raspberry Pi OS disables it by default).
CPUWeight=50
TasksMax=512
OOMScoreAdjust=500
MemoryHigh=40%
MemoryMax=55%

[Install]
WantedBy=multi-user.target
