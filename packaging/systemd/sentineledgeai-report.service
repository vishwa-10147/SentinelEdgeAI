[Unit]
Description=SentinelEdgeAI: Write the daily security summary (PDF + JSON)
Documentation=https://github.com/vishwa-10147/SentinelEdgeAI

[Service]
Type=oneshot
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentineledgeai/current
EnvironmentFile=/etc/sentinel/sentinel.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/sentineledgeai/current/.venv/bin/python -m reporting.summary daily --out /var/lib/sentinel/reports
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sentinel /var/log/sentinel
