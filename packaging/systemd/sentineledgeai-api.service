[Unit]
Description=SentinelEdgeAI API and web console
Documentation=https://github.com/vishwa-10147/SentinelEdgeAI
After=network-online.target sentineledgeai-engine.service
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentineledgeai/current
EnvironmentFile=/etc/sentinel/sentinel.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# HTTPS when SENTINEL_TLS_CERT / SENTINEL_TLS_KEY are set in sentinel.env
ExecStart=/opt/sentineledgeai/current/.venv/bin/python -m dashboard.serve
Restart=on-failure
RestartSec=5

# Block/unblock API calls change firewall rules.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sentinel /var/log/sentinel

# resource limits: see sentineledgeai-engine.service
CPUWeight=100
TasksMax=256
OOMScoreAdjust=100
MemoryMax=20%

[Install]
WantedBy=multi-user.target
