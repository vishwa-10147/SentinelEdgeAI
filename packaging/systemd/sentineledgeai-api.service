[Unit]
Description=SentinelEdgeAI API and web console
Documentation=https://github.com/vishwa-10147/SentinelEdgeAI
After=network-online.target sentineledgeai-engine.service
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentineledgeai/current
EnvironmentFile=/etc/sentinel/sentinel.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/sentineledgeai/current/.venv/bin/python -m uvicorn dashboard.dashboard_api:app --host ${SENTINEL_HOST} --port ${SENTINEL_PORT}
Restart=on-failure
RestartSec=5

# Block/unblock API calls change firewall rules.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sentinel /var/log/sentinel

[Install]
WantedBy=multi-user.target
